# Create a bot application at https://discord.com/developers/applications.
# Never commit the real token.
# Starlings reads DISCORD_TOKEN from this bot-local file. Deployments may use
# WINDISSECT_BOT_TOKEN instead when both product bots share one environment.
DISCORD_TOKEN=

# Set this while testing so slash-command updates appear in one server at once.
# Remove it in production to publish commands globally.
DISCORD_GUILD_ID=
